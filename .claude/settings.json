{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/application-local.yml)",
      "Read(./Fichier Suivi*)",
      "Read(./sauvegardes/**)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-migrations.sh",
            "statusMessage": "Vérification : migration Flyway déjà publiée ?"
          }
        ]
      }
    ]
  }
}
