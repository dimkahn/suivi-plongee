<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>fr.club</groupId>
  <artifactId>suivi-plongee-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>suivi-plongee (agrégateur)</name>
  <description>
    Regroupe le frontend (Angular) et le backend (Spring Boot) pour un
    `mvn install` unique depuis la racine. Le déploiement reste celui de
    docker-compose.yml : deux services indépendants (voir backend/Dockerfile
    et frontend/Dockerfile) ; ce pom ne fait que regrouper la compilation
    locale, il ne change rien à la topologie de prod.
  </description>

  <!--
    Le frontend d'abord : si un jour le backend doit embarquer les fichiers
    statiques compilés, l'ordre du reacteur les aura déjà produits.
  -->
  <modules>
    <module>frontend</module>
    <module>backend</module>
  </modules>

  <profiles>
    <!--
      Lance les deux serveurs de développement (Angular + Spring Boot) depuis
      un seul terminal : `mvn -N -Pdev antrun:run@dev`. Le `-N` est nécessaire
      pour que Maven ne traite que ce pom agrégateur (le plugin n'est
      volontairement pas hérité par frontend/ ni backend/, voir
      `inherited=false` ci-dessous) sans quoi il tenterait de rejouer la même
      cible dans chaque module.

      Le frontend (`npm start`, bloquant) est détaché en tâche de fond via un
      shell (sortie journalisée dans frontend/frontend-dev.log, pid dans
      frontend/frontend-dev.pid) ; le backend (`mvn spring-boot:run`, lui
      aussi bloquant) reste au premier plan pour recevoir le Ctrl+C usuel. Ce
      profil ne remplace pas les commandes séparées documentées dans
      CLAUDE.md, qui restent le repli si besoin de logs frontend au premier
      plan. Arrêt propre du frontend : `mvn -N -Pdev antrun:run@dev-stop`.
    -->
    <profile>
      <id>dev</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>dev</id>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <echo message="Démarrage du frontend (npm start) en arrière-plan..."/>
                    <exec executable="sh" dir="${project.basedir}/frontend" failonerror="true">
                      <arg value="-c"/>
                      <arg value="npm start &gt; frontend-dev.log 2&gt;&amp;1 &amp; echo $! &gt; frontend-dev.pid"/>
                    </exec>
                    <echo message="Frontend lancé (voir frontend/frontend-dev.log). Démarrage du backend..."/>
                    <exec executable="mvn" failonerror="true">
                      <arg value="-f"/>
                      <arg value="${project.basedir}/backend/pom.xml"/>
                      <arg value="spring-boot:run"/>
                    </exec>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>dev-stop</id>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <exec executable="sh" dir="${project.basedir}/frontend" failonerror="false">
                      <arg value="-c"/>
                      <arg value="[ -f frontend-dev.pid ] &amp;&amp; kill $(cat frontend-dev.pid) 2&gt;/dev/null; rm -f frontend-dev.pid"/>
                    </exec>
                    <echo message="Frontend arrêté (s'il tournait encore)."/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
