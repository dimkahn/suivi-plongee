# Reverse proxy HTTPS pour le déploiement internet. Caddy obtient et
# renouvelle seul le certificat Let's Encrypt pour {$DOMAINE} — aucune
# configuration TLS manuelle, à condition que ce nom de domaine pointe déjà
# vers l'IP publique de la machine (voir DEPLOIEMENT.md).

{$DOMAINE} {
	reverse_proxy frontend:80
}

# Sites en plus, propres à la machine (un fichier *.caddy par site), rangés
# hors du dépôt : dossier CADDY_SITES du .env, vide par défaut (caddy-sites/).
# Un service lancé sur l'hôte même se joint par host.docker.internal.
import /etc/caddy/sites/*.caddy
