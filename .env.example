# Copier en .env (jamais commité) puis remplir avant :
#   docker compose -f docker-compose.prod.yml up -d --build

# Nom de domaine qui pointe vers l'IP publique de la machine (ex: un
# sous-domaine DuckDNS gratuit : suivi-cppjvo.duckdns.org). Sert à la fois
# à Caddy (certificat HTTPS) et au backend (liens envoyés par e-mail, CORS).
DOMAINE=

# Facultatif : dossier de sites Caddy en plus (un fichier *.caddy par site,
# par exemple un autre service de la machine sur son propre nom de domaine).
# Caddy obtient et renouvelle leurs certificats comme celui de DOMAINE.
# CADDY_SITES=/home/moi/caddy-sites

# Facultatif : dossier des vidéos d'aide servies sous /medias/videos/ (page /videos) ;
# par défaut videos-publiees/ à la racine du dépôt. Rempli par
# outils/videos/publier.sh.
# VIDEOS=/home/moi/suivi-plongee-videos

# Généré une fois, à conserver précieusement (perdre ce mot de passe ne
# perd pas les données : il suffit de le changer aussi côté Postgres).
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

# Facultatif : clé qui scelle les fiches de sécurité signées par le DP
# (openssl rand -base64 48). Vide : JWT_SECRET sert aussi à ça. Une fois des
# fiches signées, ne plus changer la clé utilisée (ni JWT_SECRET si celle-ci
# est vide) : toutes les fiches signées paraîtraient modifiées.
SIGNATURE_FICHES_CLE=

# Serveur SMTP pour l'envoi réel des e-mails (réinitialisation de mot de
# passe, invitation d'un moniteur). Avec Gmail : SMTP_HOTE=smtp.gmail.com,
# SMTP_UTILISATEUR l'adresse Gmail, et SMTP_MOT_DE_PASSE un mot de passe
# d'application (16 caractères, généré dans les paramètres du compte Google
# après activation de la validation en deux étapes — le mot de passe
# habituel du compte ne fonctionne pas). Voir le README, section « Envoi
# d'e-mail (SMTP) ».
SMTP_HOTE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=

# Adresse affichée comme expéditeur. Avec Gmail, doit correspondre à
# SMTP_UTILISATEUR (ou à un alias « Envoyer en tant que » configuré dessus),
# sinon Gmail ignore ou rejette l'expéditeur. Facultatif : valeur par défaut
# dans application.yml si laissé vide.
MAIL_EXPEDITEUR=

# Nom de la structure, affiché en en-tête de la fiche de sécurité PDF
# (obligatoire par l'article A322-72 : c'est un document de l'établissement).
# Facultatif : valeur par défaut dans application.yml si laissé vide.
CLUB_NOM=

# Facultatif : clé d'API Anthropic (console.anthropic.com, payante à l'usage,
# moins d'un centime par photo). Le montant, la date et la catégorie d'une
# note de frais de séjour sont toujours lus sur le téléphone (OCR, gratuit) ;
# avec cette clé, c'est l'IA de Claude qui les lit, mieux sur les notes
# difficiles, et la photo est alors envoyée à Anthropic au moment de la
# lecture. Vide : lecture sur le téléphone seulement.
LECTURE_NOTES_CLE_API=
