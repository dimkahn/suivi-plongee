# Copier en .env (jamais commité) puis remplir avant :
#   docker compose -f docker-compose.prod.yml up -d --build

# Nom de domaine qui pointe vers l'IP publique de la machine (ex: un
# sous-domaine DuckDNS gratuit : suivi-cppjvo.duckdns.org). Sert à la fois
# à Caddy (certificat HTTPS) et au backend (liens envoyés par e-mail, CORS).
DOMAINE=

# Généré une fois, à conserver précieusement (perdre ce mot de passe ne
# perd pas les données : il suffit de le changer aussi côté Postgres).
DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=

# Serveur SMTP pour l'envoi réel des e-mails (réinitialisation de mot de
# passe, invitation d'un moniteur). Avec Gmail : SMTP_HOTE=smtp.gmail.com,
# SMTP_UTILISATEUR l'adresse Gmail, et SMTP_MOT_DE_PASSE un mot de passe
# d'application (16 caractères, généré dans les paramètres du compte Google
# après activation de la validation en deux étapes — le mot de passe
# habituel du compte ne fonctionne pas). Voir le README, section « Envoi
# d'e-mail (SMTP) ».
SMTP_HOTE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=

# Adresse affichée comme expéditeur. Avec Gmail, doit correspondre à
# SMTP_UTILISATEUR (ou à un alias « Envoyer en tant que » configuré dessus),
# sinon Gmail ignore ou rejette l'expéditeur. Facultatif : valeur par défaut
# dans application.yml si laissé vide.
MAIL_EXPEDITEUR=

# Nom de la structure, affiché en en-tête de la fiche de sécurité PDF
# (obligatoire par l'article A322-72 : c'est un document de l'établissement).
# Facultatif : valeur par défaut dans application.yml si laissé vide.
CLUB_NOM=

# --- Assistant IA (facultatif, voir DEPLOIEMENT.md « Assistant IA en production »)
# Image du backend avec Claude Code, git, Maven et Node.
#BACKEND_CIBLE=execution-ia
# Active l'assistant (page /ia, admins ayant le rôle IA, code d'accès par e-mail).
#IA_ACTIVE=true
# Jeton de l'abonnement Claude : `claude setup-token` sur un poste connecté.
#CLAUDE_CODE_OAUTH_TOKEN=
# Adresse des commits faits par l'assistant.
#IA_EMAIL_COMMITS=
