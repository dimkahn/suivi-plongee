{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "polices",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "comment": "Le référentiel MFT ne change qu'à une révision fédérale : il peut vivre longtemps en cache.",
      "name": "referentiel",
      "urls": ["/api/referentiels", "/api/referentiels/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "30d"
      }
    },
    {
      "comment": "Grilles et séances : le réseau prime, le cache sert de filet après 3 secondes. Le cache applicatif IndexedDB prend le relais au-delà.",
      "name": "donnees-formation",
      "urls": ["/api/cursus", "/api/cursus/**", "/api/seances"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ],
  "navigationRequestStrategy": "performance",
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**"]
}
